{
  "name": "posting-assistant",
  "productName": "Posting Assistant",
  "version": "1.6.0",
  "description": "Posting Assistant - AI posting agent: picks videos and posts from your PC, writes captions in your style and schedules them on Buffer, YouTube, Instagram, Facebook, TikTok, LinkedIn and more.",
  "author": "Bunny",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64"
  },
  "build": {
    "appId": "com.bunny.postingassistant",
    "productName": "Posting Assistant",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "mac": { "category": "public.app-category.productivity", "icon": "build/icon.png", "identity": null, "hardenedRuntime": false },
    "dmg": { "title": "Posting Assistant" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Posting Assistant",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
